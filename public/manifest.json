{
  "manifest_version": 3,
  "name": "KORUS Toolkit",
  "version": "0.1.1",
  "description": "A focused browser extension for the KORUS workflow.",
  "permissions": ["storage"],
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "KORUS Toolkit"
  },
  "content_scripts": [
    {
      "matches": ["https://knue.korus.ac.kr/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
